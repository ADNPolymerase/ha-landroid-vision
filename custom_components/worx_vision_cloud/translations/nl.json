  "options": {
    "step": {
      "init": {
        "title": "Verbindingsrapportage",
        "data": {
          "disconnect_grace_minutes": "Vertraging voordat een verbroken verbinding wordt gemeld (minuten, 0 = direct)",
          "blade_service_hours": "Onderhoudsinterval messen (maaiuren)",
          "battery_service_cycles": "Onderhoudsdrempel accu (laadcycli)"
        },
        "data_description": {
          "disconnect_grace_minutes": "Korte cloud-/MQTT-onderbrekingen zijn normaal (herverbindingen, wifi-dips, slaapstand van de maaier). Een verbroken verbinding verschijnt pas op de sensoren Online en MQTT verbonden wanneer deze langer duurt dan deze vertraging; herverbinding wordt altijd direct gemeld. De ruwe live-status blijft beschikbaar in de sensorattributen.",
          "blade_service_hours": "De onderhoudssensor en de Reparaties-melding markeren mesonderhoud zodra de maaitijd sinds de laatste reset deze waarde overschrijdt. Typische pendelmessen gaan 60-120 uur mee.",
          "battery_service_cycles": "Markeert accu-onderhoud zodra de laadcycli sinds de laatste reset deze waarde overschrijden. Worx Li-Ion-accu's zijn berekend op ongeveer 500-800 cycli."
        }
      }
    }
  },
  "services": {
    "start_one_time_mowing": {
      "name": "Eenmalig maaien starten",
      "description": "Start een eenmalige maaisessie met gekozen duur, optioneel randen maaien en een optionele RTK-zonelijst.",
      "fields": {
        "entity_id": {
          "name": "Maaier",
          "description": "De Worx Landroid Vision PLUS maaier-entiteit."
        },
        "runtime": {
          "name": "Maaitijd",
          "description": "Duur van het eenmalige maaien in minuten. Zet 0 met randen maaien aan om alleen randen te maaien."
        },
        "edge_cut": {
          "name": "Randen maaien",
          "description": "Of de eenmalige maaisessie randen maaien omvat."
        },
        "zones": {
          "name": "Zones",
          "description": "Optionele lijst met RTK-zone-id's, bijvoorbeeld [1, 2]. Leeg laten voor standaard maaien zonder zonebeperking."
        }
      }
    },
    "set_rtk_map_id": {
      "name": "RTK-kaart-id instellen",
      "description": "Stelt de gecachte RTK-kaart-id handmatig in wanneer Worx deze niet opnieuw verstuurt. De laatst bekende waarde staat in de geschiedenis van de RTK-kaartsensor en deblokkeert de camera en afhankelijke sensoren direct.",
      "fields": {
        "entity_id": {
          "name": "Maaier",
          "description": "De Worx Landroid Vision PLUS maaier-entiteit."
        },
        "map_id": {
          "name": "Kaart-id",
          "description": "Een bekende RTK-kaart-id (UUID), bijvoorbeeld uit de geschiedenis van de RTK-kaartsensor."
        }
      }
    },
    "set_firmware_notes": {
      "name": "Firmware-release-informatie opslaan",
      "description": "Slaat de release-informatie van een firmwareversie op zodat die leesbaar blijft in het updatevenster. Worx levert deze informatie alleen zolang een update openstaat en haalt die weg zodra de update is geïnstalleerd. De informatie van de firmware die de maaier al draait kan hier dus vanuit het Worx-accountportaal worden geplakt.",
      "fields": {
        "entity_id": {
          "name": "Maaier",
          "description": "De grasmaaier-entiteit van de Worx Landroid Vision PLUS."
        },
        "version": {
          "name": "Firmwareversie",
          "description": "De firmwareversie van de maaier die deze informatie beschrijft, bijvoorbeeld 3.46.0+47. Standaard de nu geïnstalleerde versie."
        },
        "mower_notes": {
          "name": "Informatie maaier",
          "description": "Release-informatie van de maaierfirmware."
        },
        "head_version": {
          "name": "Versie van de Vision-kop",
