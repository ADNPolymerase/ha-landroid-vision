    },
    "stopped_away_from_base": {
      "title": "Газонокосилка остановилась вне базы ({mower_name})",
      "description": "{mower_name} стоит уже {minutes} мин вне базы и не заряжается. Возможно, кнопка STOP зажата, например препятствием, или косилка застряла. Сама на зарядку она не вернётся, поэтому проверьте её, пока батарея не разрядилась."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Отчёт о подключении",
        "data": {
          "disconnect_grace_minutes": "Задержка перед сообщением об отключении (минуты, 0 = сразу)",
          "blade_service_hours": "Интервал обслуживания ножей (часы стрижки)",
          "battery_service_cycles": "Порог обслуживания батареи (циклы зарядки)",
          "calendar_window_days": "Период календаря (дней до и после сегодняшнего дня)"
        },
        "data_description": {
          "disconnect_grace_minutes": "Короткие обрывы cloud/MQTT — это нормально (переподключения, сбои wifi, спящий режим газонокосилки). Отключение появляется на датчиках «В сети» и «MQTT подключено» только если длится дольше этой задержки; восстановление связи всегда отображается сразу. Необработанное состояние остаётся доступным в атрибутах датчиков.",
          "blade_service_hours": "Датчик обслуживания и уведомление в Ремонте отмечают обслуживание ножей, когда время стрижки с последнего сброса превышает это значение. Типичные поворотные ножи служат 60-120 часов.",
          "battery_service_cycles": "Отмечает обслуживание батареи, когда циклы зарядки с последнего сброса превышают это значение. Li-Ion аккумуляторы Worx рассчитаны примерно на 500-800 циклов.",
          "calendar_window_days": "Календарь стрижки повторяет недельное расписание. Он показывает интервалы только за указанное число дней до и после сегодняшнего дня."
        }
      }
    }
  },
  "services": {
    "start_one_time_mowing": {
      "name": "Запустить разовую стрижку",
      "description": "Запускает разовую стрижку. На косилке Vision это разовая стрижка приложения Worx: зоны и обработка кромки по желанию, без длительности, а приостановленная задача заменяется. Старые модели стригут выбранное время.",
      "fields": {
        "entity_id": {
          "name": "Газонокосилка",
          "description": "Сущность газонокосилки Worx Landroid Vision PLUS."
        },
        "runtime": {
          "name": "Время стрижки",
          "description": "Время стрижки в минутах, используется только косилками без RTK. Косилка Vision стрижёт свои зоны до конца и его не учитывает."
        },
