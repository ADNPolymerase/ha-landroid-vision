  "issues": {
    "blade_service_due": {
      "title": "Knivservice påkrævet ({mower_name})",
      "description": "Knivene på {mower_name} har samlet {hours} t klippetid siden sidste nulstilling (grænse: {threshold_hours} t). Udskift eller vend knivene, og tryk derefter på knappen til nulstilling af knivtælleren på enhedssiden."
    },
    "battery_service_due": {
      "title": "Batteriservice anbefales ({mower_name})",
      "description": "{mower_name} har gennemført {cycles} opladningscyklusser siden sidste nulstilling (grænse: {threshold_cycles}). Tjek batteriet, og tryk derefter på knappen til nulstilling af cyklustælleren på enhedssiden."
    },
    "stopped_away_from_base": {
      "title": "Robotplæneklipperen er stoppet uden for ladestationen ({mower_name})",
      "description": "{mower_name} har holdt stille i {minutes} minutter uden for ladestationen og oplader ikke. STOP-knappen kan være trykket ned, for eksempel af en forhindring, eller plæneklipperen sidder fast. Den kører ikke selv tilbage for at lade, så tjek den, før batteriet løber tør."
    },
    "zone_mowing_not_acknowledged": {
      "title": "Zoneklipning ikke modtaget ({mower_name})",
      "description": "{mower_name} bekræftede ikke en zoneklipning, hverken ved afsendelse eller ved det nye forsøg, der blev sendt, da robotten meldte sig igen. Den sover sandsynligvis på sin base eller er uden for rækkevidde, så klipningen startede ikke. Start den igen fra Worx-appen eller Home Assistant. Denne advarsel forsvinder ved den næste zoneklipning, robotten bekræfter."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Forbindelsesrapportering",
        "data": {
          "disconnect_grace_minutes": "Forsinkelse før en afbrydelse rapporteres (minutter, 0 = straks)",
          "blade_service_hours": "Serviceinterval for knive (klippetimer)",
          "battery_service_cycles": "Servicetærskel for batteri (ladecyklusser)",
          "calendar_window_days": "Kalenderperiode (dage før og efter i dag)"
        },
        "data_description": {
          "disconnect_grace_minutes": "Korte cloud-/MQTT-afbrydelser er normale (genforbindelser, wifi-udfald, plæneklipperens dvale). En afbrydelse vises først på sensorerne Online og MQTT forbundet, når den varer længere end denne forsinkelse; genforbindelse vises altid straks. Den rå livestatus er stadig tilgængelig i sensorernes attributter.",
          "blade_service_hours": "Vedligeholdelsessensoren og Reparationer-advarslen markerer knivservice, når klippetiden siden sidste nulstilling overstiger denne værdi. Typiske pivotknive holder 60-120 timer.",
          "battery_service_cycles": "Markerer batteriservice, når ladecyklusserne siden sidste nulstilling overstiger denne værdi. Worx Li-Ion-batterier er klassificeret til cirka 500-800 cyklusser.",
          "calendar_window_days": "Klippekalenderen gentager ugeplanen. Den viser kun tidsrum fra dette antal dage før i dag til dette antal dage efter."
        }
      }
    }
  },
  "services": {
    "start_one_time_mowing": {
      "name": "Start engangsklipning",
      "description": "Starter en engangsklipning. På en Vision er det Worx-appens engangsklipning: zoner og kantrutine valgfrie, uden varighed, og en opgave på pause erstattes. Ældre robotter klipper den valgte tid.",
      "fields": {
        "entity_id": {
          "name": "Plæneklipper",
          "description": "Worx Landroid Vision PLUS plæneklipper-entiteten."
        },
        "runtime": {
          "name": "Klippetid",
          "description": "Klippetid i minutter, kun brugt af robotter uden RTK. En Vision klipper sine zoner færdige og ignorerer den."
        },
        "edge_cut": {
          "name": "Kantklipning",
          "description": "Om engangsklipningen skal inkludere kantklipning."
        },
        "zones": {
          "name": "Zoner",
          "description": "Valgfri liste over RTK-zone-id'er i klipperækkefølge, f.eks. [2, 1]. Lad den være tom for at klippe alle zoner."
        }
      }
    },
    "set_rtk_map_id": {
      "name": "Angiv RTK-kort-id",
      "description": "Angiver det cachede RTK-kort-id manuelt, når Worx ikke sender det igen. Den senest kendte værdi findes i RTK-kortsensorens historik og frigiver kameraet og afhængige sensorer med det samme.",
      "fields": {
        "entity_id": {
          "name": "Plæneklipper",
          "description": "Worx Landroid Vision PLUS plæneklipper-entiteten."
        },
        "map_id": {
          "name": "Kort-id",
          "description": "Et kendt RTK-kort-id (UUID), for eksempel fra RTK-kortsensorens historik."
        }
      }
    },
    "set_firmware_notes": {
      "name": "Gem firmwarens udgivelsesnoter",
      "description": "Gemmer udgivelsesnoterne for en firmwareversion, så de forbliver læsbare i opdateringsdialogen. Worx leverer dem kun, så længe en opdatering afventer, og fjerner dem, når den er installeret, så noterne til den firmware klipperen allerede kører kan indsættes her fra Worx kontoportal.",
      "fields": {
        "entity_id": {
          "name": "Plæneklipper",
          "description": "Plæneklipperentiteten for Worx Landroid Vision PLUS."
        },
        "version": {
          "name": "Firmwareversion",
          "description": "Klipperens firmwareversion, som disse noter beskriver, for eksempel 3.46.0+47. Som standard den installerede version."
        },
        "mower_notes": {
          "name": "Klipperens noter",
          "description": "Udgivelsesnoter for klipperens firmware."
        },
        "head_version": {
          "name": "Version til Vision-hovedet",
          "description": "Firmwareversionen til Vision-hovedet, for eksempel 2.5.7+12."
        },
        "head_notes": {
          "name": "Noter til Vision-hovedet",
          "description": "Udgivelsesnoter for Vision-hovedets firmware."
        }
      }
    },
    "start_zone_mowing": {
      "name": "Start zoneklipning",
      "description": "Sender robotten ud for at klippe de valgte RTK-zoner, som engangsklipningen i Worx-appen. Uden varighed: robotten klipper zonerne færdige og kører så hjem. En opgave på pause erstattes.",
      "fields": {
        "entity_id": {
          "name": "Robot",
          "description": "Enheden for Worx Landroid Vision PLUS."
        },
        "zones": {
          "name": "Zoner",
          "description": "RTK-zone-id'er, f.eks. [2, 1]. Med fast rækkefølge klippes den første først."
        },
        "zone_order": {
          "name": "Zonerækkefølge",
          "description": "Fast klipper zonerne i den angivne rækkefølge, som appens Special-tilstand. Auto lader robotten vælge, som appens Auto-tilstand."
        },
        "edge_cut": {
          "name": "Kantklipning",
