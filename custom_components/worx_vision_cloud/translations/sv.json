        },
        "data_description": {
          "disconnect_grace_minutes": "Korta cloud-/MQTT-avbrott är normala (återanslutningar, wifi-störningar, gräsklipparens viloläge). En frånkoppling visas på sensorerna Online och MQTT ansluten först när den varar längre än denna fördröjning; återanslutning visas alltid direkt. Det råa liveläget finns kvar i sensorernas attribut.",
          "blade_service_hours": "Underhållssensorn och Reparationer-varningen flaggar knivservice när klipptiden sedan senaste återställningen överskrider detta värde. Typiska pivotknivar håller 60-120 timmar.",
          "battery_service_cycles": "Flaggar batteriservice när laddcyklerna sedan senaste återställningen överskrider detta värde. Worx Li-Ion-batterier är klassade för cirka 500-800 cykler.",
          "calendar_window_days": "Klippkalendern upprepar veckoschemat. Den visar bara tidsfönster från så många dagar före i dag till så många dagar efter."
        }
      }
    }
  },
  "services": {
    "start_one_time_mowing": {
      "name": "Starta engångsklippning",
      "description": "Startar en engångsklippning med vald tid, valfri kantklippning och en valfri RTK-zonlista.",
      "fields": {
        "entity_id": {
          "name": "Gräsklippare",
          "description": "Worx Landroid Vision PLUS gräsklipparentiteten."
        },
        "runtime": {
          "name": "Klipptid",
          "description": "Engångsklippningens längd i minuter. Ange 0 med kantklippning aktiverad för att bara klippa kanter."
        },
        "edge_cut": {
          "name": "Kantklippning",
          "description": "Om engångsklippningen ska inkludera kantklippning."
        },
        "zones": {
          "name": "Zoner",
          "description": "Valfri lista med RTK-zon-id i klippordning, till exempel [2, 1]. Lämna tomt för att klippa alla zoner. Vision-firmware 3.46.0+47 ignorerar den vid en engångsklippning. För att klippa en viss zon, ange den på ett tidsfönster i veckoschemat i Worx-appen: de zonerna respekteras, ordning inräknad."
        }
      }
    },
    "set_rtk_map_id": {
      "name": "Ange RTK-kart-id",
      "description": "Anger det cachade RTK-kart-id:t manuellt när Worx inte skickar om det. Det senast kända värdet finns i RTK-kartsensorns historik och låser upp kameran och beroende sensorer direkt.",
      "fields": {
        "entity_id": {
          "name": "Gräsklippare",
          "description": "Worx Landroid Vision PLUS gräsklipparentiteten."
        },
        "map_id": {
          "name": "Kart-id",
          "description": "Ett känt RTK-kart-id (UUID), till exempel från RTK-kartsensorns historik."
        }
      }
    },
    "set_firmware_notes": {
      "name": "Spara firmwarens versionsanteckningar",
      "description": "Sparar versionsanteckningarna för en firmwareversion så att de förblir läsbara i uppdateringsdialogen. Worx levererar dem bara så länge en uppdatering väntar och tar bort dem när den är installerad, så anteckningarna för den firmware klipparen redan kör kan klistras in här från Worx kontoportal.",
      "fields": {
        "entity_id": {
          "name": "Gräsklippare",
          "description": "Gräsklipparentiteten för Worx Landroid Vision PLUS."
        },
        "version": {
          "name": "Firmwareversion",
          "description": "Klipparens firmwareversion som dessa anteckningar beskriver, till exempel 3.46.0+47. Som standard den installerade versionen."
        },
        "mower_notes": {
          "name": "Klipparens anteckningar",
          "description": "Versionsanteckningar för klipparens firmware."
        },
        "head_version": {
          "name": "Version för Vision-huvudet",
          "description": "Firmwareversionen för Vision-huvudet, till exempel 2.5.7+12."
        },
        "head_notes": {
          "name": "Anteckningar för Vision-huvudet",
          "description": "Versionsanteckningar för Vision-huvudets firmware."
        }
      }
    },
    "start_zone_mowing": {
      "name": "Starta zonklippning",
      "description": "Klipper de valda RTK-zonerna nu, i ordning, genom att lägga till ett tillfälligt tidsfönster i veckoschemat. Vision-firmware ignorerar zonerna i en engångsklippning men respekterar dem i ett tidsfönster. Schemat återställs när klipparen är tillbaka.",
      "fields": {
        "entity_id": {
          "name": "Klippare",
          "description": "Entiteten för Worx Landroid Vision PLUS."
        },
        "zones": {
          "name": "Zoner",
          "description": "RTK-zon-id i klippordning, till exempel [2, 1]. Den första klipps först."
        },
        "runtime": {
          "name": "Klipptid",
          "description": "Hur länge jobbet pågår, i minuter."
        },
        "edge_cut": {
          "name": "Kantklippning",
          "description": "Om jobbet börjar med kantklippning."
        },
        "start_at": {
          "name": "Starttid",
          "description": "När jobbet börjar. Lämna tomt för att starta om två minuter. Inom de närmaste sex dagarna, eftersom veckoschemat upprepas."
