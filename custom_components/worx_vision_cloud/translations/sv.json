    "blade_service_due": {
      "title": "Knivservice krävs ({mower_name})",
      "description": "Knivarna på {mower_name} har samlat {hours} h klipptid sedan senaste återställningen (gräns: {threshold_hours} h). Byt eller vänd knivarna och tryck sedan på knappen för att nollställa knivräknaren på enhetssidan."
    },
    "battery_service_due": {
      "title": "Batteriservice rekommenderas ({mower_name})",
      "description": "{mower_name} har genomfört {cycles} laddcykler sedan senaste återställningen (gräns: {threshold_cycles}). Kontrollera batteriet och tryck sedan på knappen för att nollställa cykelräknaren på enhetssidan."
    },
    "stopped_away_from_base": {
      "title": "Robotgräsklipparen har stannat utanför laddstationen ({mower_name})",
      "description": "{mower_name} har stått stilla i {minutes} minuter utanför laddstationen och laddar inte. STOP-knappen kan vara intryckt, till exempel av ett hinder, eller så har klipparen fastnat. Den åker inte tillbaka och laddar av sig själv, så kontrollera den innan batteriet tar slut."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Anslutningsrapportering",
        "data": {
          "disconnect_grace_minutes": "Fördröjning innan en frånkoppling rapporteras (minuter, 0 = direkt)",
