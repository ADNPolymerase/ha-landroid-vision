  "options": {
    "step": {
      "init": {
        "title": "Raportowanie łączności",
        "data": {
          "disconnect_grace_minutes": "Opóźnienie zgłaszania rozłączenia (minuty, 0 = natychmiast)",
          "blade_service_hours": "Interwał serwisu ostrzy (godziny koszenia)",
          "battery_service_cycles": "Próg serwisu baterii (cykle ładowania)"
        },
        "data_description": {
          "disconnect_grace_minutes": "Krótkie przerwy cloud/MQTT są normalne (ponowne połączenia, zaniki wifi, uśpienie kosiarki). Rozłączenie pojawia się na czujnikach Online i MQTT połączono dopiero, gdy trwa dłużej niż to opóźnienie; ponowne połączenie jest zawsze zgłaszane natychmiast. Surowy stan na żywo pozostaje dostępny w atrybutach czujników.",
          "blade_service_hours": "Czujnik konserwacji i alert Napraw zgłaszają serwis ostrzy, gdy czas koszenia od ostatniego resetu przekroczy tę wartość. Typowe ostrza obrotowe wytrzymują 60-120 godzin.",
          "battery_service_cycles": "Zgłasza serwis baterii, gdy cykle ładowania od ostatniego resetu przekroczą tę wartość. Akumulatory Li-Ion Worx są przewidziane na około 500-800 cykli."
        }
      }
    }
  },
  "services": {
    "start_one_time_mowing": {
      "name": "Uruchom koszenie jednorazowe",
      "description": "Uruchamia jednorazowe koszenie z wybranym czasem pracy, opcjonalnym koszeniem krawędzi i opcjonalną listą stref RTK.",
      "fields": {
        "entity_id": {
          "name": "Kosiarka",
          "description": "Encja kosiarki Worx Landroid Vision PLUS."
        },
        "runtime": {
          "name": "Czas koszenia",
          "description": "Czas koszenia jednorazowego w minutach. Ustaw 0 z włączonym koszeniem krawędzi, aby kosić tylko krawędzie."
        },
        "edge_cut": {
          "name": "Koszenie krawędzi",
          "description": "Czy jednorazowe koszenie ma zawierać koszenie krawędzi."
        },
        "zones": {
          "name": "Strefy",
          "description": "Opcjonalna lista identyfikatorów stref RTK, np. [1, 2]. Puste pole oznacza domyślne koszenie bez ograniczenia stref."
        }
      }
    },
    "set_rtk_map_id": {
      "name": "Ustaw identyfikator mapy RTK",
      "description": "Ręcznie ustawia identyfikator mapy RTK w pamięci podręcznej, gdy Worx go nie wysyła. Ostatnią znaną wartość znajdziesz w historii czujnika mapy RTK, aby natychmiast odblokować kamerę mapy i zależne czujniki.",
      "fields": {
        "entity_id": {
          "name": "Kosiarka",
          "description": "Encja kosiarki Worx Landroid Vision PLUS."
        },
        "map_id": {
          "name": "Identyfikator mapy",
          "description": "Znany identyfikator mapy RTK (UUID), np. z historii czujnika mapy RTK."
        }
      }
    },
    "set_firmware_notes": {
      "name": "Zapisz informacje o wersji oprogramowania",
      "description": "Zapisuje informacje o wersji oprogramowania, aby pozostały czytelne w oknie aktualizacji. Worx udostępnia je tylko wtedy, gdy aktualizacja oczekuje, i usuwa je po instalacji, więc informacje o oprogramowaniu już działającym na kosiarce można wkleić tutaj z portalu konta Worx.",
      "fields": {
        "entity_id": {
          "name": "Kosiarka",
          "description": "Encja kosiarki Worx Landroid Vision PLUS."
        },
        "version": {
          "name": "Wersja oprogramowania",
          "description": "Wersja oprogramowania kosiarki opisana przez te informacje, na przykład 3.46.0+47. Domyślnie wersja obecnie zainstalowana."
        },
        "mower_notes": {
