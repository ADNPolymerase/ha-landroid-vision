    },
    "battery_service_due": {
      "title": "Zalecany serwis akumulatora ({mower_name})",
      "description": "Kosiarka {mower_name} wykonała {cycles} cykli ładowania od ostatniego resetu (próg: {threshold_cycles}). Sprawdź stan akumulatora, a następnie naciśnij przycisk resetu licznika cykli na stronie urządzenia."
    }
